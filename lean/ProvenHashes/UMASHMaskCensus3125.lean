def maskPairList3125 : List (Σ _ : ℕ, ℕ) :=
  (sortedUnique maskList3125).flatMap fun m =>
    (patternList3125 m).map fun t => ⟨m,t⟩

theorem maskPairList3125_toFinset : maskPairList3125.toFinset = maskPatternPairs := by
  have hm (m : ℕ) : m ∈ sortedUnique maskList3125 ↔ m ∈ maskSet := by
    rw [← List.mem_toFinset, sortedUnique_toFinset, maskSet_eq_certificate]
    rfl
  have ht (m t : ℕ) : t ∈ patternList3125 m ↔ t ∈ maskPatterns m := by
    rw [← List.mem_toFinset, patternList3125_toFinset]
  ext mt
  constructor
  · intro h
    obtain ⟨m,hm',hmem⟩ := List.mem_flatMap.mp (List.mem_toFinset.mp h)
    obtain ⟨t,ht',he⟩ := List.mem_map.mp hmem
    cases he
    exact Finset.mem_sigma.mpr ⟨(hm m).mp hm', (ht m t).mp ht'⟩
  · intro h

def patternList3125 (m : ℕ) : List ℕ :=
  ((List.range 17).filter fun j =>
    decide (0 ≤ patternNumerator m j ∧ patternNumerator m j % 2 = 0 ∧
      (patternNumerator m j / 2).toNat &&& m = (patternNumerator m j / 2).toNat)).map
        (fun j => (patternNumerator m j / 2).toNat)

theorem patternList3125_toFinset (m : ℕ) :
    (patternList3125 m).toFinset = maskPatterns m := by
  ext t
  simp [patternList3125, maskPatterns]
